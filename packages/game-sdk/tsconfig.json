/**
 * @file   packages/game-sdk/tsconfig.json
 * @module game-sdk
 * @brief  TypeScript settings for @smg/game-sdk.
 *
 * Responsibility: extend the shared strict base and limit the program to src/. node types
 *                 are included so the DRBG and the commitment can call node:crypto; the
 *                 package itself stays pure (same input, same output).
 * Spec:           docs/spec/10-repository-structure.md §2
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"]
}

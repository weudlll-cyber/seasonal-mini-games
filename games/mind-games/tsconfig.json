/**
 * @file   games/mind-games/tsconfig.json
 * @module games/mind-games
 * @brief  TypeScript settings for the Seasonal Mind Games module.
 *
 * Responsibility: extend the shared strict base and limit the program to src/. node types
 *                 are included for the tests, which build round randomness with the SDK's
 *                 crypto entry; the module itself only receives a RoundRng.
 * Spec:           docs/spec/10-repository-structure.md §2
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"]
}

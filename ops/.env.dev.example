# @file   ops/.env.dev.example
# @brief  Local ports and placeholder credentials for ops/compose.dev.yml.
#
# Responsibility: make the dev stack start without setup. Development only: everything
#                 listens on 127.0.0.1. Override in ops/.env.dev (ignored by git).
# Used by:        ops/compose.dev.yml (docker compose --env-file)
# Spec:           docs/spec/10-repository-structure.md §4; Bingo 08 §5
#
# Local ports: this machine runs several projects, so this one has its own range.
#   Used here:          5510 PostgreSQL, 1110 Mailpit SMTP, 8510 Mailpit web UI
#   Used by pnpm dev:   3910 server, 5410 player client, 5411 admin client
#   Never use (Seasonal Bingo Royale): 3900, 5390, 5391, 5490, 1090, 8490
#   Never use (other projects): 3800, 5380, 7880, 7881, 3478, 5349, 50000-50499
#                               (Seasonal Entertainment), 4000, 5173, 4173 (race game),
#                               5273, 8000 (mining game)

SMG_DEV_POSTGRES_PORT=5510
SMG_DEV_MAILPIT_SMTP_PORT=1110
SMG_DEV_MAILPIT_UI_PORT=8510

POSTGRES_USER=smg
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=smg

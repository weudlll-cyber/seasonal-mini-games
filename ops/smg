#!/usr/bin/env bash
# @file   ops/smg
# @module ops
# @brief  The operator's command on the server: the kit's admin command with this game's hooks.
#
# Responsibility: the verbs every game shares are the kit's (ops/lib/admin.sh, its
#                 docs/OPERATIONS.md "The admin command"; DECISIONS T437): status, update <git
#                 ref>, confirm, rollback, backup, restore [--drill] <file>, logs [service],
#                 uninstall [--purge-backups]; --env <name> and --yes anywhere. Here: the
#                 game's settings and hooks — update builds the ref, waits up to 10 minutes for
#                 running rounds to end (--now: not at all), writes the keys the backups keep,
#                 installs the ref's stack files and sets up the database roles before the new
#                 image starts; status adds the type, the address, the rounds running,
#                 maintenance and, for website installs, the sign-in mode, the authorize
#                 endpoint, the account feed and the trusted proxy ranges; uninstall takes the
#                 game's route file and keys with it — and its own verbs: admin create-super
#                 (the first admin of a standalone install, password asked inside the app,
#                 never echoed; refused on a website install), admin promote-super --website-id
#                 <id> | --name <name> (website installs: a member who signed in once through
#                 the website becomes super admin, DECISIONS T243), maintenance on|off (a flag
#                 file the app reads: no new matches and no new rounds, running rounds finish)
#                 and keys <backup> --identity <file> (the round and recovery keys of a backup
#                 back into the env file, after a restore on a server set up anew).
# Depends on:     /opt/smg/lib/*.sh, /opt/smg/kit/ops/ (admin.sh, backup.sh, website-route.sh),
#                 Docker Compose, age
# Spec:           docs/spec/10-repository-structure.md §6; Bingo 09 §4–§6
# The kit calls the hooks below by name.
# shellcheck disable=SC2329
set -euo pipefail
# Errors inside $(…) stop the script too (Bingo audit O1).
shopt -s inherit_errexit

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
# shellcheck source=lib/config.sh
source "$HERE/lib/config.sh"
# shellcheck source=lib/website.sh
source "$HERE/lib/website.sh"
# shellcheck source=lib/backup.sh
source "$HERE/lib/backup.sh"

# The kit library's settings (it reads them by name).
# shellcheck disable=SC2034
{
  SK_ADMIN_NAME=smg SK_ADMIN_PREFIX=smg
  SK_ADMIN_ETC=$SMG_ETC SK_ADMIN_STATE=${SMG_STATE:-/var/lib/smg} SK_ADMIN_ROOT=$SMG_ROOT
  SK_ADMIN_IMAGE_REPO=smg-app SK_ADMIN_IMAGE_KEY=SMG_IMAGE SK_ADMIN_REF_KEY=SMG_REF
  SK_ADMIN_DEFAULT_ENV=$(env_value "$SMG_ETC/install.conf" SMG_ENV)
  SK_ADMIN_READY_URL=http://127.0.0.1:3100/readyz
  # What an update replaces and a rollback puts back, under the install root.
  SK_ADMIN_STACK_FILES='compose.yml compose.website.yml compose.website-nginx.yml caddy lib kit smg'
}
SMG_NOW=0

game_compose() { compose "$@"; }
game_backup_settings() { backup_settings "$1"; }

game_usage() {
  cat <<'EOF'
  update <git ref> [--now]       (it first waits for running rounds, 10 minutes at most;
                                 --now: not at all; migrations run before the new app starts)
  admin create-super             create the first admin account (standalone installs)
  admin promote-super --website-id <id> | --name <name>
                                 website installs: make a website member, after their
                                 first sign-in, the super admin
  maintenance on|off             no new matches or rounds while on; running rounds finish
  keys <file> --identity <k>     put a backup's round and recovery keys back, then restart
          [--force-env]
EOF
}

game_status() {
  local env=$1 file="$SMG_ETC/$1.env"
  info "type:        $(env_value "$file" SMG_INSTALL_TYPE)"
  info "address:     $(env_value "$file" SMG_PUBLIC_URL)"
  if sk_admin_ready "$env"; then info "rounds:      $(running_rounds "$env") running"; fi
  if compose "$env" exec -T app test -f /data/maintenance 2>/dev/null; then
    info "maintenance: ON (no new matches or rounds)"
  else
    info "maintenance: off"
  fi
  if [[ $(env_value "$file" SMG_INSTALL_TYPE) == website ]]; then website_status "$env"; else info "sign-in:     local"; fi
}

database() { compose "$1" exec -T postgres psql -U smg -d smg -tA -c "$2"; }
game_migrations() { database "$1" 'SELECT count(*) FROM smg.schema_migrations'; }
# Rounds that would be cut short by a restart (they resume from their log, 04 §5.3).
running_rounds() { database "$1" "SELECT count(*) FROM smg.rounds WHERE status IN ('countdown', 'open')"; }

# wait_rounds <env>: up to 10 minutes for running rounds to end (10 §6), checked every 10 s.
wait_rounds() {
  local env=$1 i n
  for i in $(seq 1 60); do
    n=$(running_rounds "$env")
    ((n == 0)) && return 0
    ((i == 1)) && info "Waiting for $n running round(s) to end (at most 10 minutes; --now restarts at once)."
    sleep 10
  done
  warn "rounds still running after 10 minutes; restarting now (they resume from their event log)"
}

game_build() {
  build_image "$(env_value "$SMG_ETC/install.conf" SMG_REPO)" "$2"
  # shellcheck disable=SC2034 # read by the kit's update
  SK_ADMIN_NEW_IMAGE=$SMG_IMAGE
}

game_before_update() {
  ((SMG_NOW)) || wait_rounds "$1"
  # Before the update's backup, which keeps them.
  write_keys "$1"
}

# The new ref's stack files, put in place by that ref's own installer library.
game_install_stack() (
  src="$SMG_ROOT/src"
  git -C "$src" -c advice.detachedHead=false checkout --quiet --force "${SK_ADMIN_NEW_IMAGE#smg-app:}"
  # shellcheck source=/dev/null
  source "$src/ops/lib/common.sh"
  # shellcheck source=/dev/null
  source "$src/ops/lib/config.sh"
  SMG_IMAGE=$SK_ADMIN_NEW_IMAGE
  install_files "$src/ops"
)

# The env file as it was (a rollback puts it back), then what the new stack needs, made by the
# installed (new) library.
game_before_start() (
  install -m 0600 "$SMG_ETC/$1.env" "$SK_ADMIN_STATE/$1/env.before"
  # shellcheck source=/dev/null
  source "$SMG_ROOT/lib/common.sh"
  # shellcheck source=/dev/null
  source "$SMG_ROOT/lib/config.sh"
  prepare_database "$1"
)

# A rollback that restored the data: it belongs to the superuser until the roles are set again
# (a stack from before the roles has none).
game_after_restore() {
  if (($2)) && [[ -n $(env_value "$SMG_ETC/$1.env" SMG_DB_APP_PASSWORD) ]]; then apply_db_roles "$1"; fi
}

game_route_settings() {
  if [[ $(env_value "$SMG_ETC/$1.env" SMG_INSTALL_TYPE) == website ]]; then route_settings "$1"; fi
}

game_uninstall_extra() { rm -f "$SMG_ETC/$1.keys"; }

# admin_create_super <env> <e-mail> <name>: a local account with a password; a website install
# has none that could sign in, so it is refused there before anything is asked.
admin_create_super() {
  local env=$1 email=$2 name=$3 tty=()
  if [[ $(env_value "$SMG_ETC/$env.env" SMG_AUTH_MODE) == website ]]; then
    die "this is a website install: players sign in only through the website, so a local admin account could never sign in. Sign in once through the website, then run: sudo smg admin promote-super --website-id <your website user id> (or --name <your display name>)"
  fi
  ask email "Admin e-mail" "$(env_value "$SMG_ETC/$env.env" SMG_ADMIN_EMAIL)"
  ask name "Admin display name (3–24 letters or digits)" admin
  [[ -t 0 ]] || tty=(-T)
  compose "$env" exec "${tty[@]}" app node dist/cli.js create-super --email "$email" --name "$name"
}

# admin_promote_super <env> <website id> <name>: the website member by user id or name becomes
# super admin; the app finds the account, refuses an unknown or shared name and says what it did.
admin_promote_super() {
  local env=$1 target=()
  if [[ -n $2 ]]; then
    target=(--website-id "$2")
  elif [[ -n $3 ]]; then
    target=(--name "$3")
  else
    die "usage: smg admin promote-super --website-id <website user id> | --name <display name>"
  fi
  compose "$env" exec -T app node dist/cli.js promote-super "${target[@]}"
}

game_cmd_admin() {
  local env=$1 what=${2:-} email='' name='' id=''
  # --yes (the kit's option) also answers this game's questions with their defaults.
  # shellcheck disable=SC2034 # read by ask (lib/common.sh)
  ((SK_ADMIN_YES)) && SMG_YES=1
  shift 2 2>/dev/null || shift
  while (($#)); do
    case $1 in
      --email) email=${2:?--email needs an address}; shift ;;
      --name) name=${2:?--name needs a name}; shift ;;
      --website-id) id=${2:?--website-id needs an id}; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  case $what in
    create-super) admin_create_super "$env" "$email" "$name" ;;
    promote-super) admin_promote_super "$env" "$id" "$name" ;;
    *) die "usage: smg admin create-super | smg admin promote-super --website-id <id> | --name <name>" ;;
  esac
}

game_cmd_maintenance() {
  case ${2:-} in
    on) compose "$1" exec -T app touch /data/maintenance && info "maintenance on: no new matches or rounds; running rounds finish" ;;
    off) compose "$1" exec -T app rm -f /data/maintenance && info "maintenance off" ;;
    *) die "usage: smg maintenance on|off" ;;
  esac
}

game_cmd_keys() {
  local env=$1 file='' identity='' force=0
  shift
  while (($#)); do
    case $1 in
      --identity) identity=${2:?--identity needs a file}; shift ;;
      --force-env) force=1 ;;
      *) file=$1 ;;
    esac
    shift
  done
  [[ -f $file && -n $identity ]] ||
    die "usage: smg keys <backup file> --identity <age key file> [--force-env]"
  sk_admin_confirm "Replace the round and recovery keys of $env with the backup's?"
  restore_keys "$env" "$file" "$identity" "$force"
  compose "$env" up -d
  sk_admin_wait_ready "$env"
}

# shellcheck source=/dev/null
source "$SMG_ROOT/kit/ops/lib/admin.sh"

main() {
  local word args=()
  # --now belongs to update; the kit knows only its own options.
  for word in "$@"; do
    if [[ $word == --now ]]; then SMG_NOW=1; else args+=("$word"); fi
  done
  sk_admin_main "${args[@]}"
}

# In braces and ended here: an update replaces this file while it runs.
{
  main "$@"
  exit
}

#!/usr/bin/env bash
# @file   ops/smg
# @module ops
# @brief  The operator's CLI on the server: status, update, rollback, backup, restore, logs, admin, maintenance.
#
# Responsibility: one command per task of Bingo 09 §4 for the environment of the install record
#                 (or --env): status (type, address, image, containers, health, last
#                 backup, timer, maintenance, rounds running); update <git ref> [--now]
#                 (waits up to 10 minutes for running rounds to end unless --now; then
#                 backup, plain pre-update dump for a rollback, image built from the ref,
#                 restart, the app migrates on start, app images no environment uses
#                 pruned); confirm (the update works:
#                 the plain pre-update dump and the rollback data are deleted); rollback
#                 (backup of the current state, confirmation, previous image and ref, and the
#                 pre-update dump restored when the update migrated the schema — everything
#                 since the update is then lost); backup; restore <file> and restore --drill
#                 <file> (--identity <age key file> for encrypted backups, --force-env for
#                 another environment's backup); logs [service]; admin create-super (the
#                 first admin, password asked inside the app, never echoed); maintenance
#                 on|off (a flag file the app reads: no new matches and no new rounds, running
#                 rounds finish). --yes skips the confirmations. Adapted from Bingo's ops/sbr.
# Depends on:     /opt/smg/lib/*.sh, Docker Compose, age
# Spec:           docs/spec/10-repository-structure.md §6; Bingo 09 §4–§6
set -euo pipefail
# Errors inside $(…) stop the script too (Bingo audit O1).
shopt -s inherit_errexit

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
# shellcheck source=lib/config.sh
source "$HERE/lib/config.sh"
# shellcheck source=lib/website.sh
source "$HERE/lib/website.sh"
# shellcheck source=lib/backup.sh
source "$HERE/lib/backup.sh"

ROLLBACK_DIR=/var/lib/smg

usage() {
  cat <<'EOF'
usage: smg [--env prod|staging] [--yes] <command>
  status                         what runs, its health and the last backup
  update <git ref> [--now]       wait for running rounds (10 min at most, --now: not at
                                 all), backup, build the ref, restart (migrations run on
                                 start; running rounds resume from their event log)
  confirm                        the update works: delete the pre-update dump and rollback data
  rollback                       back to the image (and data) before the last update
  backup                         encrypted backup now
  restore <file> [--identity k]  put a backup back (k: your age key file for .age files;
          [--force-env]          --force-env: the backup is of another environment)
  restore --drill <file> [...]   restore into a throw-away database and check it
  logs [service]                 follow the logs (app, postgres, caddy)
  admin create-super             create the first admin account
  maintenance on|off             no new matches or rounds while on; running rounds finish
EOF
}

cmd_status() {
  local env=$1 file="$SMG_ETC/$1.env" last
  info "type:        $(env_value "$file" SMG_INSTALL_TYPE) (environment $env)"
  info "address:     $(env_value "$file" SMG_PUBLIC_URL)"
  info "image:       $(env_value "$file" SMG_IMAGE) (ref $(env_value "$SMG_ETC/install.conf" SMG_REF))"
  compose "$env" ps --format 'table {{.Service}}\t{{.Status}}'
  if compose "$env" exec -T app wget -qO- http://127.0.0.1:3100/readyz >/dev/null 2>&1; then
    info "health:      ready"
    info "rounds:      $(running_rounds "$env") running"
  else
    info "health:      NOT READY (smg logs app)"
  fi
  # The names carry the time, so the last in name order is the newest.
  # Before the first backup the folder does not exist yet: that is no error (pipefail).
  last=$({ find "$SMG_BACKUPS/$env" -maxdepth 1 -name 'smg-*.tar.age' 2>/dev/null || true; } | sort | tail -1)
  info "last backup: ${last:-none yet}"
  info "next backup: $(systemctl show "smg-backup@$env.timer" -p NextElapseUSecRealtime --value 2>/dev/null || echo unknown)"
  [[ -f $ROLLBACK_DIR/$env/rollback.conf ]] && info "rollback:    possible (smg confirm deletes the pre-update dump)"
  if compose "$env" exec -T app test -f /data/maintenance 2>/dev/null; then
    info "maintenance: ON (no new matches or rounds)"
  else
    info "maintenance: off"
  fi
  if [[ $(env_value "$file" SMG_INSTALL_TYPE) == website ]]; then check_proxy "$env"; fi
}

# Website installs trust the website network's range; it holds while that network exists.
check_proxy() {
  local env=$1 network now trusted
  [[ -n $(website_caddy) ]] || { warn "the website's Caddy is not running"; return 0; }
  network=$(env_value "$SMG_ETC/$env.env" SMG_WEBSITE_NETWORK)
  now=$(network_subnet "$network")
  trusted=$(env_value "$SMG_ETC/$env.env" SMG_TRUSTED_PROXIES)
  if [[ $now == "$trusted" ]]; then
    info "proxy:       the website's network $network ($now)"
  else
    warn "the website's network is now $now, the app trusts $trusted: run the installer again to update it"
  fi
}

migrations() { compose "$1" exec -T postgres psql -U smg -d smg -tA -c 'SELECT count(*) FROM smg.schema_migrations'; }

# Rounds that would be cut short by a restart (they resume from their log, 04 §5.3).
running_rounds() {
  compose "$1" exec -T postgres psql -U smg -d smg -tA -c \
    "SELECT count(*) FROM smg.rounds WHERE status IN ('countdown', 'open')"
}

# wait_rounds <env>: up to 10 minutes for running rounds to end (10 §6), checked every 10 s.
wait_rounds() {
  local env=$1 i n
  for i in $(seq 1 60); do
    n=$(running_rounds "$env")
    ((n == 0)) && return 0
    ((i == 1)) && info "Waiting for $n running round(s) to end (at most 10 minutes; --now restarts at once)."
    sleep 10
  done
  warn "rounds still running after 10 minutes; restarting now (they resume from their event log)"
}

# The images any environment runs or could roll back to; the others are pruned (Bingo audit O11).
images_in_use() {
  local file
  for file in "$SMG_ETC"/*.env; do env_value "$file" SMG_IMAGE; done
  for file in "$ROLLBACK_DIR"/*/rollback.conf; do [[ -f $file ]] && env_value "$file" PREVIOUS_IMAGE; done
  return 0
}

cmd_update() {
  local env=$1 ref=${2:-} now=${3:-} file="$SMG_ETC/$1.env" dir="$ROLLBACK_DIR/$1" conf="$SMG_ETC/install.conf"
  [[ -n $ref && $ref != --now ]] || die "usage: smg update <git ref> [--now]"
  [[ $now == --now ]] || wait_rounds "$env"
  do_backup "$env"
  info "Backup before the update: $BACKUP_FILE"
  install -d -m 0700 "$dir"
  # Written whole or not at all (Bingo audit O10); deleted by smg confirm (Bingo audit O3).
  cleanup_path "$dir/pre-update.dump.partial"
  (umask 077 && compose "$env" exec -T postgres pg_dump -U smg -Fc smg >"$dir/pre-update.dump.partial")
  mv "$dir/pre-update.dump.partial" "$dir/pre-update.dump"
  printf 'PREVIOUS_IMAGE=%s\nPREVIOUS_REF=%s\nMIGRATIONS_BEFORE=%s\n' "$(env_value "$file" SMG_IMAGE)" \
    "$(env_value "$conf" SMG_REF)" "$(migrations "$env")" | put_file "$dir/rollback.conf" 0600
  build_image "$(env_value "$conf" SMG_REPO)" "$ref"
  set_env_value "$file" SMG_IMAGE "$SMG_IMAGE"
  set_env_value "$conf" SMG_REF "$ref"
  compose "$env" up -d
  wait_ready "$env"
  # shellcheck disable=SC2046 # one image name per word
  prune_images $(images_in_use)
  info "Updated to $ref ($SMG_IMAGE)."
  info "Check the game, then: smg confirm (deletes the plain pre-update dump), or smg rollback."
}

cmd_confirm() {
  local dir="$ROLLBACK_DIR/$1"
  [[ -f $dir/rollback.conf ]] || die "no update waiting for confirmation"
  rm -f "$dir/pre-update.dump" "$dir/rollback.conf"
  # shellcheck disable=SC2046 # one image name per word
  prune_images $(images_in_use)
  info "Update confirmed: the pre-update dump is deleted; a rollback is no longer possible."
}

cmd_rollback() {
  local env=$1 dir="$ROLLBACK_DIR/$1" file="$SMG_ETC/$1.env" restore=0
  [[ -f $dir/rollback.conf ]] || die "no update to roll back"
  local previous_image previous_ref before now
  previous_image=$(env_value "$dir/rollback.conf" PREVIOUS_IMAGE)
  previous_ref=$(env_value "$dir/rollback.conf" PREVIOUS_REF)
  before=$(env_value "$dir/rollback.conf" MIGRATIONS_BEFORE)
  now=$(migrations "$env")
  ((now <= before)) || restore=1
  if ((restore)); then
    confirm "Roll back to $previous_image? The update changed the database schema, so the data goes back to the moment before the update: everything since then is lost (a backup is taken first)."
  else
    confirm "Roll back to $previous_image? The data stays as it is."
  fi
  do_backup "$env"
  info "Backup of the current state: $BACKUP_FILE"
  set_env_value "$file" SMG_IMAGE "$previous_image"
  if [[ -n $previous_ref ]]; then set_env_value "$SMG_ETC/install.conf" SMG_REF "$previous_ref"; fi
  if ((restore)); then
    info "Restoring the dump taken before the update."
    compose "$env" stop app
    restore_database "$env" "$dir/pre-update.dump"
  fi
  compose "$env" up -d
  wait_ready "$env"
  rm -f "$dir/rollback.conf" "$dir/pre-update.dump"
  info "Rolled back to $previous_image (ref ${previous_ref:-unknown})."
}

# do_backup runs as a plain command, so set -e stops it at the first error (Bingo audit O1).
cmd_backup() {
  do_backup "$1"
  info "Backup written: $BACKUP_FILE"
}

cmd_restore() {
  local env=$1 drill=0 file='' identity='' force_env=0
  shift
  while (($#)); do
    case $1 in
      --drill) drill=1 ;;
      --identity) identity=$2; shift ;;
      --force-env) force_env=1 ;;
      *) file=$1 ;;
    esac
    shift
  done
  [[ -f $file ]] || die "usage: smg restore [--drill] <file> [--identity <age key file>] [--force-env]"
  if ((drill)); then do_drill "$file" "$identity"; else do_restore "$env" "$file" "$identity" "$force_env"; fi
}

cmd_admin() {
  local env=$1 email name tty=()
  [[ ${2:-} == create-super ]] || die "usage: smg admin create-super"
  email=${SMG_ADMIN_EMAIL_FLAG:-}
  name=${SMG_ADMIN_NAME_FLAG:-}
  ask email "Admin e-mail" "$(env_value "$SMG_ETC/$env.env" SMG_ADMIN_EMAIL)"
  ask name "Admin display name (3–24 letters or digits)" admin
  [[ -t 0 ]] || tty=(-T)
  compose "$env" exec "${tty[@]}" app node dist/cli.js create-super --email "$email" --name "$name"
}

cmd_maintenance() {
  case ${2:-} in
    on) compose "$1" exec -T app touch /data/maintenance && info "maintenance on: no new matches or rounds; running rounds finish" ;;
    off) compose "$1" exec -T app rm -f /data/maintenance && info "maintenance off" ;;
    *) die "usage: smg maintenance on|off" ;;
  esac
}

main() {
  local env='' args=()
  # The global options may stand anywhere (smg rollback --yes); the rest goes to the command.
  while (($#)); do
    case $1 in
      --env) env=$2; shift ;;
      --email) SMG_ADMIN_EMAIL_FLAG=$2; shift ;;
      --name) SMG_ADMIN_NAME_FLAG=$2; shift ;;
      --yes) SMG_YES=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]}"
  [[ $EUID -eq 0 ]] || die "run as root: sudo smg $*"
  env=${env:-$(env_value "$SMG_ETC/install.conf" SMG_ENV)}
  [[ -n $env && -f $SMG_ETC/$env.env ]] || die "no installation found (run ops/install.sh first)"
  local command=${1:-}
  shift || true
  case $command in
    status) cmd_status "$env" ;;
    update) cmd_update "$env" "$@" ;;
    confirm) cmd_confirm "$env" ;;
    rollback) cmd_rollback "$env" ;;
    backup) cmd_backup "$env" ;;
    restore) cmd_restore "$env" "$@" ;;
    logs) compose "$env" logs -f --tail=200 "$@" ;;
    admin) cmd_admin "$env" "$@" ;;
    maintenance) cmd_maintenance "$env" "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"

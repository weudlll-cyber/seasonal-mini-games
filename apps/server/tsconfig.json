/**
 * @file   apps/server/tsconfig.json
 * @module server
 * @brief  TypeScript settings for @smg/server.
 *
 * Responsibility: extend the shared strict base; include src/ and test/; pull in the
 *                 @types/node ambient types that the server needs (fs, crypto, http).
 * Spec:           docs/spec/10-repository-structure.md §2
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src", "test"]
}

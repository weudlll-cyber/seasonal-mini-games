# @file   apps/server/dev.env
# @module server
# @brief  Settings of `pnpm dev`: the development features on (never on a public address).
#
# Responsibility: development mode with the development features, and the database of
#                 ops/compose.dev.yml (port 5510, development-only password). A variable
#                 already set in the shell wins (node --env-file never overrides).
# Used by:        apps/server/package.json (script "dev"), the root `pnpm dev`
# Spec:           Bingo 08 §1
NODE_ENV=development
SMG_DEV=1
DATABASE_URL=postgres://smg:change-me-dev-only@127.0.0.1:5510/smg

/**
 * @file   apps/web/tsconfig.json
 * @module web
 * @brief  TypeScript settings for @smg/web.
 *
 * Responsibility: extend the bundler base; include src/; opt into the React JSX
 *                 runtime so `.tsx` files type-check against the installed React.
 * Spec:           docs/spec/10-repository-structure.md §2
 */
{
  "extends": "../../tsconfig.bundler.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}

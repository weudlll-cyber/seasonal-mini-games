{
  "name": "seasonal-mini-games",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @smg/server --filter @smg/web --filter @smg/admin run dev",
    "dev:reset-db": "pnpm --filter @smg/server db:reset-dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check --cache --cache-strategy content",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --project \"!@smg/server\" && vitest run --project @smg/server src/ && vitest run --project @smg/server test/",
    "test:unit": "vitest run --project @smg/game-sdk --project @smg/guess-engine --project @smg/domain --project @smg/application --project @smg/contracts --project @smg-game/*",
    "test:coverage": "vitest run packages/game-sdk packages/guess-engine packages/domain packages/application games/guess-the-number games/safecracker games/bomb-defusal games/seasonal-target games/mind-games games/registry --coverage --testTimeout=20000",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "drill:dev": "bash ops/dev-drill.sh",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@seasonal/kit": "github:weudlll-cyber/seasonal-kit#v0.40.0",
    "@smg/contracts": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}

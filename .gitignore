# Dependencies and build output
node_modules/
dist/
coverage/
# tsc's incremental state of each project (tsconfig.base.json, DECISIONS T401)
*.tsbuildinfo
# Test output
test-results/
playwright-report/
# Local environment files hold secrets and never go into git
.env
.env.*
!.env.example
# Committed templates with placeholder values, e.g. ops/.env.dev.example
!.env.*.example
# Night runs (docs/NIGHT-RUN.md): the run log and the task text stay local
logs/
night-task.md
# One-off scripts of a run, deleted when the step is done
tmp/
# Local outputs: screenshots of the latest browser-test run (e2e/screens.ts and the specs
# write them to reports/screens/latest/), play-throughs, load and scan results. Nothing under
# reports/ is tracked: a run's images and its play-through go to an orphan branch
# shots/<night> (DECISIONS T146); the reports tracked until 2026-11-16 are in the tag
# archive/reports-2026-11-16.
reports/
# Editor and OS noise
.DS_Store
Thumbs.db
